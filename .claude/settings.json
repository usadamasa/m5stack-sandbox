{
  "enabledPlugins": {
    "cwc-makers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_ALLOW_GH_PR_WRITES": "1",
    "CLAUDE_ALLOW_GH_ISSUE_WRITES": "1"
  },
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(buddy-mcpd *)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "uv *",
      "uvx *",
      "buddy-mcpd *"
    ],
    "filesystem": {
      "allowWrite": [
        "/dev/cu.usbmodem*",
        "/dev/tty.usbmodem*",
        "~/.cache/m5-onboard"
      ]
    },
    "network": {
      "allowedDomains": [
        "m5burner-api.m5stack.com",
        "m5burner.m5stack.com"
      ]
    }
  }
}
