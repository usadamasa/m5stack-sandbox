{
  "enabledPlugins": {
    "cwc-makers@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(/Users/masaru_uchida/src/github.com/usadamasa/m5stack-sandbox/.venv/bin/python:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/buddy_chatter_notify.py",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "/Users/masaru_uchida/src/github.com/usadamasa/m5stack-sandbox/.venv/bin/python *"
    ],
    "filesystem": {
      "allowWrite": [
        "/dev/cu.usbmodem*",
        "/dev/tty.usbmodem*",
        "~/.cache/m5-onboard"
      ]
    },
    "network": {
      "allowedDomains": [
        "m5burner-api.m5stack.com",
        "m5burner.m5stack.com"
      ]
    }
  }
}
